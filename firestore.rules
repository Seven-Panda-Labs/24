rules_version = '2';

// Data model: docs/architecture.md. Every collection here has cases in
// firestore.rules.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    // Google is the only sign-in method. Checking the provider here too means an
    // account from any other provider gets nothing, even if one is enabled in
    // the console by mistake.
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Google accounts come verified. Without this check anyone could claim an
    // invite with an unverified account that uses someone else's email.
    function verified() {
      return request.auth.token.email_verified == true;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validName(name, max) {
      return name is string && name.size() > 0 && name.size() <= max;
    }

    function validMember(member) {
      return member.keys().hasOnly(['name', 'email'])
        && member.name is string && member.name.size() <= 80
        && member.email is string && member.email.size() <= 200;
    }

    // Push tokens of the user's devices and the language for reminders. Only
    // the user reads or writes it; the reminder function uses the Admin SDK.
    match /users/{uid} {
      function validUser(data) {
        return data.keys().hasOnly(['fcmTokens', 'language'])
          && data.fcmTokens is list && data.fcmTokens.size() <= 10
          && data.language is string && data.language.size() <= 10;
      }

      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validUser(request.resource.data);
    }

    // Everyone who has signed in to this instance, suggested when inviting.
    // Instances are private, so anyone signed in may read it; each person
    // writes only their own entry, with their own email.
    match /people/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && validMember(request.resource.data)
        && request.resource.data.email == email();
    }

    // A calendar and who is in it. Everyone in it can do everything: edit,
    // invite, take others out and delete it. Nobody joins without accepting.
    match /calendars/{cid} {
      function isMember() {
        return request.auth.uid in resource.data.memberIds;
      }

      function invited() {
        return verified() && email() in resource.data.invitedEmails;
      }

      // memberIds (for queries) and the members map (for display) name the
      // same people. Calendars from before the sack have none.
      function validCalendar(c) {
        return c.keys().hasOnly(['year', 'person', 'name', 'startDate', 'dayCount', 'allowRepeats', 'originality', 'days', 'sack', 'tags', 'memberIds', 'members', 'invitedEmails', 'createdAt', 'updatedAt'])
          && c.year is int && c.year >= 2000 && c.year <= 2100
          && validName(c.person, 80)
          && c.name is string && c.name.size() <= 80
          && c.startDate is string && c.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && c.dayCount is int && c.dayCount >= 1 && c.dayCount <= 31
          && c.allowRepeats is bool
          && c.originality is number && c.originality >= 0 && c.originality <= 1
          && c.days is map && c.days.size() <= 31
          && (!c.keys().hasAny(['sack']) || (c.sack is map && c.sack.size() <= 100))
          && c.tags is map && c.tags.size() <= 30
          && c.memberIds is list && c.memberIds.size() >= 1 && c.memberIds.size() <= 20
          && c.members.keys().toSet() == c.memberIds.toSet()
          && c.invitedEmails is list && c.invitedEmails.size() <= 20;
      }

      // Anything but adding people: they only join by accepting.
      function memberUpdate() {
        let data = request.resource.data;
        let people = data.members.diff(resource.data.members);
        return isMember()
          && data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
          && people.addedKeys().size() == 0
          && people.changedKeys().size() == 0
          && validCalendar(data);
      }

      // An invited person adds themselves and removes their own invite, nothing else.
      function acceptInvite() {
        let data = request.resource.data;
        return invited()
          && !isMember()
          && changed().hasOnly(['memberIds', 'members', 'invitedEmails'])
          && data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && data.memberIds.size() <= 20
          && data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && validMember(data.members[request.auth.uid])
          && data.members[request.auth.uid].email == email()
          && data.invitedEmails.toSet() == resource.data.invitedEmails.toSet().difference([email()].toSet());
      }

      function declineInvite() {
        return invited()
          && changed().hasOnly(['invitedEmails'])
          && request.resource.data.invitedEmails.toSet() == resource.data.invitedEmails.toSet().difference([email()].toSet());
      }

      allow read: if signedIn() && (isMember() || invited());

      allow create: if signedIn()
        && request.resource.data.memberIds == [request.auth.uid]
        && validMember(request.resource.data.members[request.auth.uid])
        && request.resource.data.members[request.auth.uid].email == email()
        && request.resource.data.invitedEmails == []
        && validCalendar(request.resource.data);

      allow update: if signedIn() && (memberUpdate() || acceptInvite() || declineInvite());

      allow delete: if signedIn() && isMember();

      // Implicit feedback on the calendar's suggestions: append-only.
      match /feedback/{fid} {
        function inCalendar() {
          return request.auth.uid in get(/databases/$(database)/documents/calendars/$(cid)).data.memberIds;
        }

        allow read: if signedIn() && inCalendar();
        allow create: if signedIn() && inCalendar()
          && request.resource.data.keys().hasOnly(['gift', 'action', 'at'])
          && validName(request.resource.data.gift, 200)
          && request.resource.data.action in ['accepted', 'dismissed']
          && request.resource.data.at == request.time;
      }
    }
  }
}
