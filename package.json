{
  "name": "24",
  "version": "0.16.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-24 \"vitest run --config vitest.config.rules.ts\"",
    "check": "npm --prefix functions run build && npm run build && npm run lint && npm run test && npm run test:rules && npm run check:changelog",
    "check:changelog": "tsx scripts/verify-changelog.ts",
    "import:excel": "tsx scripts/import-excel.ts",
    "check:licenses": "npm run licenses -- --start . && npm run licenses -- --start functions",
    "licenses": "license-checker-rseidelsohn --production --summary --excludePrivatePackages --onlyAllow 'MIT;Apache-2.0;BSD-3-Clause;BSD-2-Clause;ISC;0BSD;MPL-2.0'",
    "setup:githooks": "git config core.hooksPath .githooks",
    "emulators": "firebase emulators:start --project demo-24",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes,storage,functions",
    "deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.15.0",
    "i18next": "^26.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.22.3",
    "license-checker-rseidelsohn": "^4.4.2",
    "oxlint": "^1.69.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "@opentelemetry/core": "^2.8.0",
    "glob": "^14.0.4",
    "uuid": "^11.1.1"
  }
}
