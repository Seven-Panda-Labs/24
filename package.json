{
  "name": "24",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-24 \"vitest run --config vitest.config.rules.ts\"",
    "check": "npm run build && npm run lint && npm run test && npm run test:rules && npm run check:changelog",
    "check:changelog": "tsx scripts/verify-changelog.ts",
    "check:licenses": "license-checker-rseidelsohn --production --summary --excludePrivatePackages --onlyAllow 'MIT;Apache-2.0;BSD-3-Clause;BSD-2-Clause;ISC;0BSD;MPL-2.0'",
    "setup:githooks": "git config core.hooksPath .githooks",
    "emulators": "firebase emulators:start --project demo-24",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes,storage",
    "deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "firebase": "^12.15.0",
    "i18next": "^26.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "firebase-tools": "^15.22.3",
    "license-checker-rseidelsohn": "^4.4.2",
    "oxlint": "^1.69.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
