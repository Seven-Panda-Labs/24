rules_version = '2';

// Gift photos, readable and writable by the people in their calendar. Who is in
// it is read from Firestore; in production the first deploy asks to grant
// Storage access to Firestore for these cross-service rules.
service firebase.storage {
  match /b/{bucket}/o {
    function inCalendar(cid) {
      // Google only, as in firestore.rules.
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid in firestore.get(/databases/(default)/documents/calendars/$(cid)).data.memberIds;
    }

    match /calendars/{cid}/photos/{file} {
      allow read, delete: if inCalendar(cid);
      allow create: if inCalendar(cid)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 5 * 1024 * 1024;
    }
  }
}
